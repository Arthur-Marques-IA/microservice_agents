# Servidor
APP_HOST=0.0.0.0
APP_PORT=8000

# Banco (Postgres + pgvector via docker-compose)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/agent_service

# Redis (mensageria assíncrona)
REDIS_URL=redis://localhost:6379/0

# Modelo padrão (Gemini)
DEFAULT_MODEL_PROVIDER=google
DEFAULT_MODEL_ID=gemini-2.5-flash
GOOGLE_API_KEY=

# Mem0 (opcional, fase 2)
MEM0_ENABLED=false
MEM0_API_KEY=

# LangSmith (observabilidade)
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-service
